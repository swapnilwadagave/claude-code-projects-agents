# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# Required: ngrok auth token for the public tunnel
# Get yours at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Optional: GitHub personal access token
# Raises the GitHub API rate limit from 60 to 5000 req/hr during Docker build.
# Create one at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=your_github_pat_here
